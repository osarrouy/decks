    "./components/Fragment.svelte": "./src/lib/components/Fragment.svelte",
    "./components/PresenterView.svelte": "./src/lib/components/PresenterView.svelte",
    "./components/SlideSurface.svelte": "./src/lib/components/SlideSurface.svelte",
    "./components/TwoColumns.svelte": "./src/lib/components/TwoColumns.svelte",
    "./deck/controller": "./src/lib/deck/controller.ts",
    "./deck/imageGlow": "./src/lib/deck/imageGlow.ts",
    "./deck/markdown": "./src/lib/deck/markdown.ts",
    "./deck/singleFile": "./src/lib/deck/singleFile.ts",
