# Blockchain
Distributed consensus {.kicker}

---
<!-- slide: steps=2 -->

<script>
  import Fragment from "@svx-deck/core/components/Fragment.svelte";
</script>

<Fragment at={0}>

Monnaie {.kicker}

</Fragment>

