{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * "{$SITE_ROOT:/srv}"
	encode zstd gzip

	# Revalidate mutable course pages and media after a deployment.
	@mutable not path /_app/immutable/* /slides/*/_app/immutable/*
	header @mutable Cache-Control "public, max-age=0, must-revalidate"
	@immutable path /_app/immutable/* /slides/*/_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
	handle_errors 404 {
		header Cache-Control "public, max-age=0, must-revalidate"
		rewrite * /404.html
		file_server
	}
}
