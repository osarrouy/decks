{
  "name": "university",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "dependencies": {
    "@svx-deck/core": "workspace:*"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "dev:blockchain": "svx-deck dev decks/blockchain",
    "dev:blockchain-bitcoin": "svx-deck dev decks/blockchain-bitcoin",
    "dev:blockchain-consensus": "svx-deck dev decks/blockchain-consensus",
    "dev:blockchain-ethereum": "svx-deck dev decks/blockchain-ethereum",
    "dev:blockchain-gouvernance": "svx-deck dev decks/blockchain-gouvernance",
    "dev:blockchain-mechanism-design": "svx-deck dev decks/blockchain-mechanism-design",
    "dev:blockchain-monnaie": "svx-deck dev decks/blockchain-monnaie",
    "dev:blockchain-nft": "svx-deck dev decks/blockchain-nft",
    "dev:cybernetics": "svx-deck dev decks/cybernetics",
    "dev:economics": "svx-deck dev decks/economics",
    "dev:history-1": "svx-deck dev decks/history-1",
    "dev:history-3": "svx-deck dev decks/history-3",
    "dev:interpassivity": "svx-deck dev decks/interpassivity",
    "dev:introduction": "svx-deck dev decks/introduction",
    "dev:social-networks": "svx-deck dev decks/social-networks",
    "dev:social-networks-structure": "svx-deck dev decks/social-networks-structure",
    "dev:social-networks-gatekeepers": "svx-deck dev decks/social-networks-gatekeepers",
    "dev:social-networks-virality": "svx-deck dev decks/social-networks-virality",
    "dev:social-networks-polarization": "svx-deck dev decks/social-networks-polarization",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "deck": "svx-deck",
    "check:site": "pnpm --filter site check && pnpm --filter site test",
    "check:deck": "pnpm --filter @svx-deck/core check && pnpm --filter @svx-deck/core test",
    "check": "pnpm check:deck && pnpm check:site",
    "test:ui": "playwright test --config tooling/playwright.js"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^3.1.0",
    "@playwright/test": "^1.63.0",
    "postcss-custom-media": "^11.0.6",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@dg/ui": "link:../../../../Code/@dg/packages/ui"
    }
  }
}
