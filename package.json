{
  "name": "svx-slides-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "dependencies": {
    "@svx-slides/components": "workspace:*"
  },
  "scripts": {
    "dev:intro": "node svx-slides/src/cli/index.mjs dev slides/introduction",
    "dev:demo": "node svx-slides/src/cli/index.mjs dev slides/demo",
    "dev:economics": "node svx-slides/src/cli/index.mjs dev slides/economics",
    "dev:rsn": "node svx-slides/src/cli/index.mjs dev slides/social-networks",
    "dev:history": "node svx-slides/src/cli/index.mjs dev slides/history-1",
    "dev:history2": "node svx-slides/src/cli/index.mjs dev slides/history-2",
    "build:demo": "node svx-slides/src/cli/index.mjs build slides/demo --public",
    "build:demo:public": "node svx-slides/src/cli/index.mjs build slides/demo --public",
    "build:demo:presenter": "node svx-slides/src/cli/index.mjs build slides/demo --presenter",
    "export:demo": "node svx-slides/src/cli/index.mjs export slides/demo",
    "export:history": "node svx-slides/src/cli/index.mjs export slides/history-1",
    "preview:demo": "node svx-slides/src/cli/index.mjs preview slides/demo",
    "preview:history": "node svx-slides/src/cli/index.mjs preview slides/history-1",
    "check": "pnpm build:demo:public && pnpm build:demo:presenter && pnpm check:cours",
    "dev:cours": "pnpm --filter cours dev",
    "build:cours": "pnpm --filter cours build",
    "preview:cours": "pnpm --filter cours preview",
    "check:cours": "pnpm --filter cours check && pnpm --filter cours test",
    "test:ui": "playwright test --config tooling/playwright.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.3",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3"
  }
}
